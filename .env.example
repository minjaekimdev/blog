# ── Giscus 댓글/좋아요 설정 ──────────────────────────────
# 발급 방법:
#   1. 블로그를 공개(public) GitHub 저장소에 푸시
#   2. 저장소 Settings → General → Discussions 체크
#   3. https://github.com/apps/giscus 설치 (저장소 선택)
#   4. https://giscus.app/ko 에서 저장소명 입력
#      - 매핑: discussion의 pathname 추천
#      - 카테고리: Announcements 추천 (관리자만 새 Discussion 생성 → 스팸 방지)
#   5. 아래 4개 값을 giscus.app 화면의 스크립트에서 복사해 채우기

GISCUS_REPO=
GISCUS_REPO_ID=
GISCUS_CATEGORY=Announcements
GISCUS_CATEGORY_ID=

# ── 작성자 GitHub 아이디 (댓글 답글 권한 식별용) ─────────
AUTHOR_GITHUB_USERNAME=minjaekimdev
