---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';

const posts = (
  await getCollection('posts', ({ data }) => !data.draft && data.category === 'retrospective')
).sort(
  (a, b) =>
    Number(b.data.pinned) - Number(a.data.pinned) ||
    b.data.date.valueOf() - a.data.date.valueOf()
);

// 연도별로 묶어서 표시
const byYear = new Map<number, typeof posts>();
for (const post of posts) {
  const year = post.data.date.getFullYear();
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(post);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---

<BaseLayout title="회고" description="김민재의 회고 목록">
  <div class="container">
    <header class="page-head">
      <h1 class="page-head__title">회고</h1>
      <p class="page-head__desc">스스로를 돌아보며 더 나아질 수 있는 방법을 고민합니다.</p>
    </header>
    {years.map((year) => (
      <section class="year-group">
        <h2 class="year-group__label">{year}</h2>
        <PostList posts={byYear.get(year)!} />
      </section>
    ))}
  </div>
</BaseLayout>
