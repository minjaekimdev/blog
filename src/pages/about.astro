---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT } from '../config';
---

<BaseLayout title="Contact" description="프론트엔드 개발자 김민재에게 연락하기">
  <div class="container">
    <header class="page-head">
      <h1 class="page-head__title">Contact</h1>
    </header>

    <div class="about-profile">
      <img
        class="about-profile__avatar"
        src="https://github.com/minjaekimdev.png"
        alt="김민재 프로필 사진"
        width="88"
        height="88"
      />
      <div>
        <p class="about-profile__name">김민재</p>
        <p class="about-profile__role">프론트엔드 개발자</p>
      </div>
    </div>

    <div class="prose">
      <p>
        다양한 사람들과 교류하며 생각을 나누는 것은 저를 나아가게 하는 원동력입니다.
        언제든 편하게 연락 주세요.
      </p>

      <h2>연락처</h2>
      <ul>
        <li>Phone — <a href={CONTACT.phoneHref}>{CONTACT.phoneDisplay}</a></li>
        <li>Email — <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></li>
        <li>LinkedIn — <a href={CONTACT.linkedin} target="_blank" rel="noopener noreferrer">linkedin.com/in/김민재</a></li>
      </ul>
    </div>
  </div>
</BaseLayout>
