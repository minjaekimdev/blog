---
const githubUser = 'minjaekimdev';
---

<div class="author-card">
  <img
    class="author-card__avatar"
    src={`https://github.com/${githubUser}.png`}
    alt="김민재 프로필 사진"
    width="56"
    height="56"
    loading="lazy"
  />
  <div>
    <p class="author-card__name">
      Written by <a href={`https://github.com/${githubUser}`} target="_blank" rel="noopener noreferrer">@{githubUser}</a>
    </p>
    <p class="author-card__role">김민재 · 프론트엔드 개발자</p>
  </div>
</div>
